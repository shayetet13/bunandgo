# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Required only the very first time (no admin account exists yet) ---
# Once an admin row exists in the database these are no longer read.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Server ---
# PORT=8790
# Comma-separated list of frontend origins allowed to call this API with
# credentials. Defaults to http://localhost:5173 (local dev) if unset.
# ALLOWED_ORIGINS=http://localhost:5173

# --- Storage ---
# DB_PATH=data/app.db

# --- Login throttling (brute-force guard on POST /api/auth/login) ---
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_MS=300000

# --- Bun/Go dispatch relay (auto-generated per boot if unset; only set
#     these if you need a stable value across restarts) ---
# DISPATCH_TOKEN=
# DISPATCH_ADDR=127.0.0.1:4790
# LINE_TRANSPORT=hybrid   # hybrid | go | direct
# DISPATCH_BINARY=1
# Number of HTTP/2 connections to legy.line-apps.com this process owns and
# picks between at send time (one carries traffic, the rest are hot
# standby). Set to 0 to send over Bun's shared fetch pool instead.
# LINE_H2_LANES=6
# Replace one old idle connection at a time so a technically-live Akamai
# route cannot slowly degrade until the whole bot is restarted. 0 disables.
# LINE_H2_LANE_MAX_AGE_MS=900000
# Minimum spacing between replacements for the same origin.
# LINE_H2_LANE_RECYCLE_GAP_MS=60000
# How often polling deliberately refreshes a standby route measurement.
# Keep poll-lanes * this value below APPLICATION_SAMPLE_MAX_AGE_MS.
# LINE_H2_POLL_EXPLORE_INTERVAL_MS=2000
# Existing poll requests calibrate each fresh connection this many times so
# its cold first response cannot permanently misclassify the route.
# LINE_H2_POLL_CALIBRATION_SAMPLES=3
# Preferred foreground tier. Real application RTT below this is HOT.
# LINE_H2_APPLICATION_HOT_CEILING_MS=20
# Routes from 20ms up to (but not including) this value remain WARM fallbacks;
# routes at/above this value are repaired in the background.
# LINE_H2_APPLICATION_DISCARD_CEILING_MS=23
# Maximum age for HOT/WARM foreground classification.
# LINE_H2_APPLICATION_SAMPLE_MAX_AGE_MS=30000
# Avoid reconnecting on one transient slow sample.
# LINE_H2_DEGRADED_REPAIR_MIN_SAMPLES=3

# --- Whole-system capacity monitor ---
# The dashboard shows percentage of these limits consumed (100% = at limit).
# An overload must persist for 3 samples (15 seconds by default) before the
# existing Telegram/webhook alert channel is notified. Recovery is also sent.
# SYSTEM_CPU_LIMIT_PERCENT=80
# SYSTEM_MEMORY_LIMIT_PERCENT=80
# SYSTEM_EVENT_LOOP_LIMIT_MS=100
# SYSTEM_MONITOR_INTERVAL_MS=5000
# SYSTEM_ALERT_SUSTAINED_SAMPLES=3
# SYSTEM_ALERT_RECOVERY_SAMPLES=3

# --- Out-of-band security and system alerts ---
# Set one or more destinations. Alerts fan out to every configured destination
# (they do not fall back from Telegram to webhook). Values may be separated by
# commas or whitespace. Never commit real tokens/URLs.
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_TELEGRAM_CHAT_IDS=123456789,-1001234567890
# ALERT_WEBHOOK_URL=https://example.invalid/legacy-single-webhook
# ALERT_WEBHOOK_URLS=https://hooks.example/one,https://hooks.example/two

# --- Advanced tuning (leave unset unless you know why you're changing
#     these — they affect the reply hot path) ---
# SEND_MIN_INTERVAL_MS=207000
# SEND_MAX_PER_WINDOW=20
# SEND_WINDOW_MS=60000
# Pause after an empty OpenChat poll before checking again. Lower = faster
# to notice a new message, at the cost of more requests/sec against LINE
# while a room is quiet — see rearm_policy.ts before changing this.
# SQUARE_IDLE_DELAY_MS=20
# Extreme OpenChat receive path: poll each enabled Square chat directly in
# parallel with the normal push listener. The first source to see a message
# wins; message-id dedupe prevents a double reply. The safe default and floor
# are 100ms. An isolated single-bot shard may request 50ms only by setting both
# the interval and the separate opt-in gate; the gate alone keeps 100ms. This
# is aggressive traffic, so disable it with SQUARE_FAST_POLL=0 if LINE starts
# rate-limiting the account. MAX_ROOMS bounds simultaneous room pollers.
# SQUARE_FAST_POLL=1
# SQUARE_FAST_POLL_INTERVAL_MS=100
# SQUARE_FAST_POLL_ALLOW_50MS=0
# Exactly one continuous OpenChat poll is permitted per LINE session. Higher
# values are logged at startup then capped, so they cannot create overlap.
# SQUARE_FAST_POLL_MAX_ROOMS=1
# SQUARE_FAST_POLL_FETCH_TIMEOUT_MS=15000
# Exactly one dedicated cursor is used per bot + room. Values above 1 are
# capped deliberately: parallel cursors compete with the reply stream and
# make a permanent LINE permission error retry in parallel.
# SQUARE_FAST_POLL_WORKERS=1
# RULE_MATCH_MAX_TEXT=
# RULE_REGEX_MAX_PATTERN=
# RULE_REPLY_MAX_TEXT=
# REPLY_CLAIM_MAX=
# REPLY_CLAIM_TTL_MS=
# AUTOMATIC_REPLY_ECHO_TTL_MS=
# HOT_WARMUP_MIN=
# HOT_WARMUP_MAX=
# HOT_WARMUP_TARGET_MS=
# HOT_WARMUP_TEXT_LIMIT=

# Answers a Square (OpenChat) moderator/co-admin bot deleting our own
# auto-reply: resend the same reply (lightly varied) instead of letting it
# just vanish. The resend fires with zero added delay by default (jitter
# unset) — it has to win the same race the original reply was already
# winning. TTL is just how long we still recognize a destroy as ours, not
# an added delay. See backend/src/bot/reply-defense.ts.
# REPLY_DEFENSE_TTL_MS=15000
# REPLY_DEFENSE_MAX_RESENDS=2
# REPLY_DEFENSE_JITTER_MIN_MS=0
# REPLY_DEFENSE_JITTER_MAX_MS=0

# After each OpenChat reply, read the room back and record whether the
# message is actually there. Tells "a rival deleted it" apart from "LINE
# accepted the send and showed it to nobody" — those look identical from
# the send side. ON by default; set to 0 to skip the extra read per reply.
# SQUARE_VERIFY_SENDS=0
# SQUARE_VERIFY_DELAY_MS=2000
# SQUARE_VERIFY_LIMIT=50

# Send the reply again when the read-back cannot find it. Left off until
# the read-back has proven trustworthy in your rooms: if it ever fails to
# see our own message for an unrelated reason, this turns every reply into
# a double post. Turn on only after seeing reply_invisible rows that match
# replies you confirmed were missing.
# SQUARE_RESEND_WHEN_INVISIBLE=1

# Repeats of the same reply text in the same room go out with a different
# invisible suffix each time, so nothing downstream can key on "the bot's
# message is exactly this string". Visible text never changes. Set to 0 to
# send byte-identical repeats again.
# REPLY_UNIQUIFY=0
# REPLY_UNIQUIFY_WINDOW_MS=300000
