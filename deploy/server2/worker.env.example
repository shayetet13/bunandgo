# Server 2 stays disabled until /etc/linebot/worker-enabled is created.
# Copy this file to /etc/linebot/worker.env and add secrets on the server only.
PORT=8791
DB_PATH=/opt/linebot/shared/worker.db
DISPATCH_ADDR=127.0.0.1:4790
LINE_TRANSPORT=hybrid
LINEJS_DEBUG_LOGS=0

# One process runs every bot; the OS schedules it across cores as it sees fit.
# 16 local H2 lanes: the four lowest-numbered carry sends only, the rest carry
# polls, and eight bots may hold a zero-delay poll slot (the rest poll at
# 100ms). Slots cannot exceed lanes minus send-reserved lanes.
LINE_H2_LANES=16
LINE_H2_SEND_RESERVED_LANES=4
SQUARE_FAST_POLL_SLOTS=8
SQUARE_FAST_POLL_INTERVAL_MS=0
SQUARE_FAST_POLL_ALLOW_ZERO_MS=1
LINE_H2_LANE_MAX_AGE_MS=1200000
LINE_H2_LANE_RECYCLE_GAP_MS=60000

# Label stamped on lane-race history rows. Keep "primary" so existing history
# stays visible; the code defaults to "standalone" when unset.
WORKER_ID=primary

# Keep the same protection policy as Server 1 after cutover.
SYSTEM_MONITOR_INTERVAL_MS=5000
SYSTEM_CPU_LIMIT_PERCENT=80
SYSTEM_RAM_LIMIT_PERCENT=80
SYSTEM_EVENT_LOOP_LIMIT_MS=100
SYSTEM_OVERLOAD_SAMPLES=3
