# Server 2 stays disabled until /etc/linebot/worker-enabled is created.
# Copy this file to /etc/linebot/worker.env and add secrets on the server only.
PORT=8791
DB_PATH=/opt/linebot/shared/worker.db
DISPATCH_ADDR=127.0.0.1:4790
LINE_TRANSPORT=hybrid
LINEJS_DEBUG_LOGS=0
LINE_H2_LANE_MAX_AGE_MS=900000
LINE_H2_LANE_RECYCLE_GAP_MS=60000

# The primary is the catch-all process. When shard B owns owner 2, exclude
# that owner here at the exact same cutover. Leave this empty only when no
# shard is active. Never set WORKER_OWNER_SCOPE in the primary env file.
WORKER_OWNER_EXCLUDE=
WORKER_OWNER_ROUTES=

# Keep the multi-bot main worker on the safe 100ms fast-poll default. A stale
# SQUARE_FAST_POLL_INTERVAL_MS=50 is still clamped to 100 unless the separate
# ALLOW_50MS gate is explicitly enabled; do not enable that gate on this worker.
SQUARE_FAST_POLL_INTERVAL_MS=100

# When a shard is active, route every excluded owner to that shard. For the
# owner-2 cutover use WORKER_OWNER_ROUTES=2=http://127.0.0.1:8792. The setup
# script writes a fresh shared token (at least 32 characters) to both env files.
WORKER_ID=linebot-worker-2
CONTROL_PLANE_TOKEN=

# Keep the same protection policy as Server 1 after cutover.
SYSTEM_MONITOR_INTERVAL_MS=5000
SYSTEM_CPU_LIMIT_PERCENT=80
SYSTEM_RAM_LIMIT_PERCENT=80
SYSTEM_EVENT_LOOP_LIMIT_MS=100
SYSTEM_OVERLOAD_SAMPLES=3

# Security/system alerts fan out to every configured destination. Multiple
# Telegram chat IDs and webhook URLs may be comma- or whitespace-separated.
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_IDS=
# ALERT_WEBHOOK_URLS=
