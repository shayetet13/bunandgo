# Second OS process on Server 2, running a disjoint subset of bots so the
# reply/poll hot path gets a second CPU core to itself. Copy this file to
# /etc/linebot/worker-shard-b.env (root:linebot, mode 640, same as
# worker.env) and fill in real values on the server only.
#
# linebot-worker-shard-b.service stays stopped until
# /etc/linebot/worker-shard-b-enabled exists — see linebot-worker-shard-b.service.

# Must differ from the primary instance's PORT (currently 8791 in
# /etc/linebot/worker.env) and DISPATCH_ADDR (currently the code default,
# 127.0.0.1:4790) or the second process fails to bind at boot.
PORT=8792
DISPATCH_ADDR=127.0.0.1:4791
DB_PATH=/opt/linebot/shared/worker.db
LINE_TRANSPORT=hybrid
LINEJS_DEBUG_LOGS=0

# Owner placement is durable in SQLite and read from the shared runtime
# topology. No owner list belongs in this process environment.
WORKER_ID=shard-b
CONTROL_PLANE_URL=http://127.0.0.1:8791
# The shared runtime topology supplies the same 32+ character control token to
# both processes. Keep it empty in this example.
CONTROL_PLANE_TOKEN=

# The runtime topology supplies 16 process-local LINE lanes for Shard B.
LINE_H2_LANES=16
LINE_H2_SEND_RESERVED_LANES=4
# Refresh only one old idle lane per minute; requests already in flight are
# never interrupted and a standby in the same send/poll partition is required.
LINE_H2_LANE_MAX_AGE_MS=900000
LINE_H2_LANE_RECYCLE_GAP_MS=60000
# Runtime caps this to one poll per LINE session, regardless of this value.
SQUARE_FAST_POLL_MAX_ROOMS=1
SQUARE_FAST_POLL_WORKERS=1
SQUARE_FAST_POLL_INTERVAL_MS=0
SQUARE_FAST_POLL_ALLOW_ZERO_MS=1

# Keep the same protection policy as the primary instance.
SYSTEM_MONITOR_INTERVAL_MS=5000
SYSTEM_CPU_LIMIT_PERCENT=80
SYSTEM_RAM_LIMIT_PERCENT=80
SYSTEM_EVENT_LOOP_LIMIT_MS=100
SYSTEM_OVERLOAD_SAMPLES=3
