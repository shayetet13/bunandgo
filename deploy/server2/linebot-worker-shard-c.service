[Unit]
Description=LINE Bot Worker 2 - shard C (third CPU core)
Wants=network-online.target
After=network-online.target
# Named "shard C" rather than "worker 3" for the same reason shard B is named
# the way it is: this unit is a third OS process on the same host as
# linebot-worker.service and linebot-worker-shard-b.service, not a different
# physical server.
#
# Deliberate cutover gate, same pattern as the other two units: nothing here
# starts a LINE session until an operator creates this file after the shared
# sticky topology has been updated to include shard-c.
ConditionPathExists=/etc/linebot/worker-shard-c-enabled

[Service]
Type=simple
User=linebot
Group=linebot
WorkingDirectory=/opt/linebot/current/backend
Environment=NODE_ENV=production
# Same on-disk database as the other two processes, deliberately: all three
# processes' bots share one `bots` table, and SQLite's WAL mode + the
# busy_timeout set in db/sqlite.ts already support multiple writers on one file.
Environment=DB_PATH=/opt/linebot/shared/worker.db
Environment=WORKER_OWNER_SCOPE=
Environment=WORKER_OWNER_EXCLUDE=
Environment=WORKER_OWNER_ROUTES=
Environment=CONTROL_PLANE_URL=
Environment=CONTROL_PLANE_TOKEN=
EnvironmentFile=/etc/linebot/worker-shard-c.env
# All three processes share a release directory, so auto-loading its .env
# would merge primary settings into this shard. Use only EnvironmentFile.
ExecStart=/usr/local/bin/bun run --no-env-file src/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/linebot/shared

[Install]
WantedBy=multi-user.target
